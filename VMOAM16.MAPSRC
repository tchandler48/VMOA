USERID KICKS
VMOAM16   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99',              X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999',            X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM16',              X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,31),LENGTH=17,INITIAL='HELP - USER LOGIN',    X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA',                 X
               ATTRB=(PROT,BRT)
LN1       KIKMDF POS=(04,10),LENGTH=60,ATTRB=(PROT),COLOR=YELLOW
LN2       KIKMDF POS=(05,10),LENGTH=60,ATTRB=(PROT),COLOR=YELLOW
LN3       KIKMDF POS=(06,10),LENGTH=60,ATTRB=(PROT),COLOR=YELLOW
LN4       KIKMDF POS=(07,10),LENGTH=60,ATTRB=(PROT),COLOR=YELLOW
LN5       KIKMDF POS=(08,10),LENGTH=60,ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,10),LENGTH=14,INITIAL='PRESS ENTER TO',       X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,25),LENGTH=06,INITIAL='RETURN',               X
               ATTRB=(PROT),COLOR=YELLOW
ERRA      KIKMDF POS=(24,10),LENGTH=50,ATTRB=(PROT),COLOR=RED
SELA      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END
