USERID KICKS
VMOAM40   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99'
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999'
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM40'
          KIKMDF POS=(02,31),LENGTH=11,INITIAL='HELP - SEND',          X
               ATTRB=(PROT,BRT) 
          KIKMDF POS=(02,43),LENGTH=06,INITIAL='A NOTE',               X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA'
          KIKMDF POS=(23,65),LENGTH=12,INITIAL='PF-12 RETURN',         X
               ATTRB=(PROT),COLOR=YELLOW
ERRA      KIKMDF POS=(24,10),LENGTH=50,ATTRB=(PROT),COLOR=RED
SELA      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END
