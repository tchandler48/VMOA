USERID KICKS
VMOAM28   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99',              X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999',            X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM28',              X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,35),LENGTH=04,INITIAL='HELP',                 X
               ATTRB=(PROT,BRT) 
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA',                 X
               ATTRB=(PROT,BRT)
LN1       KIKMDF POS=(03,10),LENGTH=60,ATTRB=(PROT)
LN2       KIKMDF POS=(04,10),LENGTH=60,ATTRB=(PROT)
LN3       KIKMDF POS=(05,10),LENGTH=60,ATTRB=(PROT)
LN4       KIKMDF POS=(06,10),LENGTH=60,ATTRB=(PROT)
LN5       KIKMDF POS=(07,10),LENGTH=60,ATTRB=(PROT)
LN6       KIKMDF POS=(08,10),LENGTH=60,ATTRB=(PROT)
LN7       KIKMDF POS=(09,10),LENGTH=60,ATTRB=(PROT)
LN8       KIKMDF POS=(10,10),LENGTH=60,ATTRB=(PROT)
LN9       KIKMDF POS=(11,10),LENGTH=60,ATTRB=(PROT)
LN10      KIKMDF POS=(12,10),LENGTH=60,ATTRB=(PROT)
LN11      KIKMDF POS=(13,10),LENGTH=60,ATTRB=(PROT)
LN12      KIKMDF POS=(14,10),LENGTH=60,ATTRB=(PROT)
LN13      KIKMDF POS=(15,10),LENGTH=60,ATTRB=(PROT)
LN14      KIKMDF POS=(16,10),LENGTH=60,ATTRB=(PROT)
LN15      KIKMDF POS=(17,10),LENGTH=60,ATTRB=(PROT)
LN16      KIKMDF POS=(18,10),LENGTH=60,ATTRB=(PROT)
LN17      KIKMDF POS=(19,10),LENGTH=60,ATTRB=(PROT)
LN18      KIKMDF POS=(20,10),LENGTH=60,ATTRB=(PROT)
LN19      KIKMDF POS=(21,10),LENGTH=60,ATTRB=(PROT)
LN20      KIKMDF POS=(22,10),LENGTH=60,ATTRB=(PROT)
          KIKMDF POS=(23,10),LENGTH=14,INITIAL='PRESS ENTER TO',       X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,25),LENGTH=06,INITIAL='RETURN',               X
               ATTRB=(PROT),COLOR=YELLOW
ERRA      KIKMDF POS=(24,10),LENGTH=50,ATTRB=(PROT),COLOR=RED
SELA      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END 
