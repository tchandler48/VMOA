USERID KICKS
VMOAM36   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99'
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999'
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM36'
          KIKMDF POS=(02,26),LENGTH=13,INITIAL='PROCESS NOTES',        X
               ATTRB=(PROT,BRT) 
          KIKMDF POS=(02,40),LENGTH=12,INITIAL='AND MESSAGES',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA'
          KIKMDF POS=(05,05),LENGTH=16,INITIAL='PF-1 SEND A NOTE',     X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(06,05),LENGTH=19,INITIAL='PF-2 SEND A MESSAGE',  X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(07,05),LENGTH=17,INITIAL='PF-3 VIEW MESSAGE',    X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(07,23),LENGTH=03,INITIAL='LOG',ATTRB=(PROT),     X
               COLOR=YELLOW
          KIKMDF POS=(08,05),LENGTH=14,INITIAL='PF-4 VIEW NOTE',       X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(08,20),LENGTH=03,INITIAL='LOG',ATTRB=(PROT),     X
               COLOR=YELLOW
          KIKMDF POS=(23,05),LENGTH=10,INITIAL='PF-10 HELP',           X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,65),LENGTH=12,INITIAL='FP-12 RETURN',         X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(24,10),LENGTH=50,ATTRB=(PROT),COLOR=RED
SELA      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END
