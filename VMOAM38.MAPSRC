USERID KICKS
VMOAM38   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99'
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999'
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM38'
          KIKMDF POS=(02,34),LENGTH=11,INITIAL='SEND A NOTE',          X
               ATTRB=(PROT,BRT) 
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA'
          KIKMDF POS=(03,01),LENGTH=08,INITIAL='SEND TO:',             X
               ATTRB=(PROT),COLOR=YELLOW
SENDTO    KIKMDF POS=(03,10),LENGTH=10,ATTRB=(FSET,IC),                X
               HILIGHT=UNDERLINE
          KIKMDF POS=(03,21),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
          KIKMDF POS=(04,01),LENGTH=05,INITIAL='FROM:',                X
               ATTRB=(PROT),COLOR=YELLOW,HILIGHT=UNDERLINE
FROM      KIKMDF POS=(04,10),LENGTH=25,HILIGHT=UNDERLINE
          KIKMDF POS=(04,36),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
          KIKMDF POS=(05,01),LENGTH=08,INITIAL='SUBJECT:',             X
               ATTRB=(PROT),COLOR=YELLOW
