USERID KICKS
VMOAM39   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99'
          KIKMDF POS=(01,28),LENGTH=13,INITIAL='VM370 OFFICE',         X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(01,41),LENGTH=10,INITIAL='AUTOMATION',           X
               ATTRB=(PROT,BRT)
CDATE     KIKMDF POS=(01,68),LENGTH=10,PICOUT='99B99B9999'
          KIKMDF POS=(02,05),LENGTH=07,INITIAL='VMOAM39'
          KIKMDF POS=(02,32),LENGTH=08,INITIAL='SEND - A',             X
               ATTRB=(PROT,BRT) 
          KIKMDF POS=(02,41),LENGTH=07,INITIAL='MESSAGE',              X
               ATTRB=(PROT,BRT)
          KIKMDF POS=(02,72),LENGTH=04,INITIAL='MAPA'
          KIKMDF POS=(05,10),LENGTH=08,INITIAL='SEND TO:',             X
               ATTRB=(PROT),COLOR=YELLOW
SDMSG     KIKMDF POS=(05,20),LENGTH=50,ATTRB=(IC,FSET),                X
               HILIGHT=UNDERLINE
          KIKMDF POS=(05,76),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
          KIKMDF POS=(07,10),LENGTH=13,INITIAL='MESSAGE TEXT:',        X
               ATTRB=(PROT),COLOR=YELLOW
SDL1      KIKMDF POS=(07,25),LENGTH=50,ATTRB=(IC,FSET),                X
               HILIGHT=UNDERLINE
          KIKMDF POS=(07,76),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
SDL2      KIKMDF POS=(09,10),LENGTH=65,ATTRB=(IC,FSET),                X
               HILIGHT=UNDERLINE
          KIKMDF POS=(09,76),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
SDL3      KIKMDF POS=(11,10),LENGTH=65,ATTRB=(FSET),                   X
               HILIGHT=UNDERLINE
          KIKMDF POS=(11,76),LENGTH=01,INITIAL=' ',ATTRB=(PROT)
          KIKMDF POS=(15,10),LENGTH=08,INITIAL='TYPE THE',             X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(15,19),LENGTH=11,INITIAL='INFORMATION',          X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(15,31),LENGTH=15,INITIAL='ABOVE AND PRESS',      X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(15,47),LENGTH=13,INITIAL='PF-7 TO SEND.',        X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,10),LENGTH=09,INITIAL='PF-7 SEND',            X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,38),LENGTH=10,INITIAL='PF-10 HELP',           X
               ATTRB=(PROT),COLOR=YELLOW
          KIKMDF POS=(23,65),LENGTH=12,INITIAL='PF-12 RETURN',         X
               ATTRB=(PROT),COLOR=YELLOW
ERRA      KIKMDF POS=(24,05),LENGTH=55,ATTRB=(PROT),COLOR=RED
SELA      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END
