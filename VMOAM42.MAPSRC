               ATTRB=(PROT),COLOR=YELLOW
ERRB      KIKMDF POS=(24,05),LENGTH=55,ATTRB=(PROT),COLOR=RED
SELB      KIKMDF POS=(24,65),LENGTH=01,ATTRB=(FSET)
          KIKMSD TYPE=FINAL
          END
