USERID KICKS
VMOAM42   KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET),EXTATT=YES,            X
               MAPATTS=(COLOR,HILIGHT),DSATTS=(COLOR,HILIGHT)
MAPA      KIKMDI SIZE=(24,80)
CTIME     KIKMDF POS=(01,05),LENGTH=08,PICOUT='99B99B99'
