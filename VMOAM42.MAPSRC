SDL1B     KIKMDF POS=(07,25),LENGTH=50,ATTRB=(PROT,NORM)
          KIKMDF POS=(07,76),LENGTH=01,ATTRB=(PROT),INITIAL=' '
SDL2B     KIKMDF POS=(09,10),LENGTH=65,ATTRB=(PROT,NORM)
SDL3B     KIKMDF POS=(11,10),LENGTH=65,ATTRB=(FSET,NORM)
          KIKMDF POS=(23,38),LENGTH=10,INITIAL='PF-10 HELP',           X
