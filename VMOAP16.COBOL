USERID KICKS
       ID DIVISION.
       PROGRAM-ID.     VMOAP16.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-CURRENT-DATE.
           05  WS-CURRENT-YEAR  PIC 9(04).
           05  WS-CURRENT-MONTH PIC 9(02).
           05  WS-CURRENT-DAY   PIC 9(02).
 
       COPY VMOAM28.
       COPY DFHBMSCA.

       PROCEDURE DIVISION.
       START-OVER.
           MOVE CURRENT-DATE TO WS-CURRENT-DATE.
           MOVE WS-CURRENT-DATE TO CDATEO.
  
           MOVE TIME-OF-DAY TO CTIMEO.
<NCB2>
           EXAMINE CTIMEO REPLACING ALL ' ' BY ':'.
</NCB2>

           MOVE 'THIS IS THE HELP SCREEN FOR LOGGING INTO THE VMOA'
                TO LN1O.
           MOVE 'SYSTEM.  THERE ARE TWO INPUTS REQUIRED:' TO LN2O.
           MOVE 'USERID AND PASSWORD.  ENTER THESE TWO REQUIRED' 
                TO LN3O.
           MOVE 'FIELDS.  iF EITHER OF THESE FIELDS ARE INCORRECT'
                TO LN4O.
           MOVE 'AN ERROR MESSAGE WILL BE DISPLAY, AND YOU WILL' 
                TO LN5O.
           EXEC KICKS
             SEND MAP('MAPA') MAPSET('VMOAM28') ERASE
             END-EXEC.

           EXEC KICKS HANDLE AID PF12(ENDPGM) END-EXEC.
           EXEC KICKS
             RECEIVE MAP('MAPA') MAPSET('VMOAM28')
             END-EXEC.

           EXEC KICKS RETURN END-EXEC.
           GO TO START-OVER.

       ENDPGM.
           EXEC KICKS XCTL PROGRAM('KSSFPGM') NOHANDLE END-EXEC. 
